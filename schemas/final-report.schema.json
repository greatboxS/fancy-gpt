{
  "$defs": {
    "Deliverable": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "content": {
          "minLength": 20,
          "title": "Content",
          "type": "string"
        }
      },
      "required": [
        "name",
        "kind",
        "content"
      ],
      "title": "Deliverable",
      "type": "object"
    },
    "EvidenceCoverage": {
      "additionalProperties": false,
      "properties": {
        "requirement_id": {
          "title": "Requirement Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "satisfied",
            "partial",
            "missing"
          ],
          "title": "Status",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence",
          "type": "array"
        },
        "note": {
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "requirement_id",
        "status",
        "note"
      ],
      "title": "EvidenceCoverage",
      "type": "object"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "locator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Locator"
        },
        "claim_supported": {
          "minLength": 3,
          "title": "Claim Supported",
          "type": "string"
        }
      },
      "required": [
        "source",
        "claim_supported"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "severity": {
          "enum": [
            "info",
            "low",
            "medium",
            "high",
            "critical"
          ],
          "title": "Severity",
          "type": "string"
        },
        "category": {
          "title": "Category",
          "type": "string"
        },
        "claim": {
          "title": "Claim",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence",
          "type": "array"
        },
        "impact": {
          "title": "Impact",
          "type": "string"
        },
        "recommendation": {
          "title": "Recommendation",
          "type": "string"
        }
      },
      "required": [
        "id",
        "severity",
        "category",
        "claim",
        "impact",
        "recommendation"
      ],
      "title": "Finding",
      "type": "object"
    },
    "Hypothesis": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "hypothesis": {
          "title": "Hypothesis",
          "type": "string"
        },
        "mechanism": {
          "title": "Mechanism",
          "type": "string"
        },
        "evidence_for": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence For",
          "type": "array"
        },
        "evidence_against": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence Against",
          "type": "array"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "next_discriminating_test": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Discriminating Test"
        }
      },
      "required": [
        "id",
        "hypothesis",
        "mechanism",
        "confidence"
      ],
      "title": "Hypothesis",
      "type": "object"
    },
    "OptionAnalysis": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "description": {
          "minLength": 3,
          "title": "Description",
          "type": "string"
        },
        "advantages": {
          "items": {
            "type": "string"
          },
          "title": "Advantages",
          "type": "array"
        },
        "disadvantages": {
          "items": {
            "type": "string"
          },
          "title": "Disadvantages",
          "type": "array"
        },
        "risks": {
          "items": {
            "type": "string"
          },
          "title": "Risks",
          "type": "array"
        },
        "when_to_choose": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "When To Choose"
        }
      },
      "required": [
        "name",
        "description"
      ],
      "title": "OptionAnalysis",
      "type": "object"
    },
    "RequestMode": {
      "enum": [
        "review",
        "design",
        "consult",
        "investigate",
        "verify",
        "write"
      ],
      "title": "RequestMode",
      "type": "string"
    },
    "ResearchTaskTrace": {
      "additionalProperties": false,
      "properties": {
        "task_id": {
          "title": "Task Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "completed",
            "blocked",
            "skipped"
          ],
          "title": "Status",
          "type": "string"
        },
        "source_urls": {
          "items": {
            "type": "string"
          },
          "title": "Source Urls",
          "type": "array"
        },
        "note": {
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "status",
        "note"
      ],
      "title": "ResearchTaskTrace",
      "type": "object"
    },
    "SourceRecord": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "authority": {
          "default": "secondary",
          "enum": [
            "primary",
            "secondary",
            "community"
          ],
          "title": "Authority",
          "type": "string"
        },
        "accessed_or_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Accessed Or Version"
        },
        "used_for": {
          "items": {
            "type": "string"
          },
          "title": "Used For",
          "type": "array"
        }
      },
      "required": [
        "title"
      ],
      "title": "SourceRecord",
      "type": "object"
    },
    "ValidationStep": {
      "additionalProperties": false,
      "properties": {
        "step": {
          "title": "Step",
          "type": "string"
        },
        "expected_evidence": {
          "title": "Expected Evidence",
          "type": "string"
        },
        "pass_condition": {
          "title": "Pass Condition",
          "type": "string"
        }
      },
      "required": [
        "step",
        "expected_evidence",
        "pass_condition"
      ],
      "title": "ValidationStep",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "request_id": {
      "title": "Request Id",
      "type": "string"
    },
    "mode": {
      "$ref": "#/$defs/RequestMode"
    },
    "status": {
      "const": "complete",
      "default": "complete",
      "title": "Status",
      "type": "string"
    },
    "verdict": {
      "title": "Verdict",
      "type": "string"
    },
    "executive_summary": {
      "title": "Executive Summary",
      "type": "string"
    },
    "report_sections_completed": {
      "items": {
        "type": "string"
      },
      "title": "Report Sections Completed",
      "type": "array"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "options": {
      "items": {
        "$ref": "#/$defs/OptionAnalysis"
      },
      "title": "Options",
      "type": "array"
    },
    "hypotheses": {
      "items": {
        "$ref": "#/$defs/Hypothesis"
      },
      "title": "Hypotheses",
      "type": "array"
    },
    "deliverables": {
      "items": {
        "$ref": "#/$defs/Deliverable"
      },
      "title": "Deliverables",
      "type": "array"
    },
    "recommendation": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Recommendation"
    },
    "assumptions_challenged": {
      "items": {
        "type": "string"
      },
      "title": "Assumptions Challenged",
      "type": "array"
    },
    "unknowns": {
      "items": {
        "type": "string"
      },
      "title": "Unknowns",
      "type": "array"
    },
    "validation_plan": {
      "items": {
        "$ref": "#/$defs/ValidationStep"
      },
      "title": "Validation Plan",
      "type": "array"
    },
    "research_trace": {
      "items": {
        "$ref": "#/$defs/ResearchTaskTrace"
      },
      "title": "Research Trace",
      "type": "array"
    },
    "evidence_coverage": {
      "items": {
        "$ref": "#/$defs/EvidenceCoverage"
      },
      "title": "Evidence Coverage",
      "type": "array"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/SourceRecord"
      },
      "title": "Sources",
      "type": "array"
    },
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    }
  },
  "required": [
    "request_id",
    "mode",
    "verdict",
    "executive_summary",
    "confidence"
  ],
  "title": "FinalReport",
  "type": "object"
}