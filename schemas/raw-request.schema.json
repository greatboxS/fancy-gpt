{
  "$defs": {
    "ArtifactRole": {
      "enum": [
        "context",
        "requirement",
        "candidate-solution",
        "evidence"
      ],
      "title": "ArtifactRole",
      "type": "string"
    },
    "ArtifactSpec": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "content": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "kind": {
          "default": "text",
          "title": "Kind",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/ArtifactRole",
          "default": "context"
        },
        "priority": {
          "$ref": "#/$defs/Priority",
          "default": "P1"
        }
      },
      "title": "ArtifactSpec",
      "type": "object"
    },
    "ChatPolicy": {
      "enum": [
        "continue",
        "new_chat",
        "independent",
        "temporary"
      ],
      "title": "ChatPolicy",
      "type": "string"
    },
    "ExpansionTrigger": {
      "enum": [
        "changes-correctness",
        "material-risk",
        "decision-quality",
        "confidence",
        "next-required-action",
        "blocking-unknown"
      ],
      "title": "ExpansionTrigger",
      "type": "string"
    },
    "Freshness": {
      "enum": [
        "static",
        "version-specific",
        "current"
      ],
      "title": "Freshness",
      "type": "string"
    },
    "Priority": {
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3",
        "P4"
      ],
      "title": "Priority",
      "type": "string"
    },
    "RelevanceSufficiencyPolicy": {
      "additionalProperties": false,
      "properties": {
        "preserve_scope": {
          "default": true,
          "title": "Preserve Scope",
          "type": "boolean"
        },
        "answer_actual_question": {
          "default": true,
          "title": "Answer Actual Question",
          "type": "boolean"
        },
        "stop_when_sufficient": {
          "default": true,
          "title": "Stop When Sufficient",
          "type": "boolean"
        },
        "expansion_triggers": {
          "items": {
            "$ref": "#/$defs/ExpansionTrigger"
          },
          "title": "Expansion Triggers",
          "type": "array"
        },
        "avoid_by_default": {
          "items": {
            "type": "string"
          },
          "title": "Avoid By Default",
          "type": "array"
        }
      },
      "title": "RelevanceSufficiencyPolicy",
      "type": "object"
    },
    "RequestMode": {
      "enum": [
        "review",
        "design",
        "consult",
        "investigate",
        "verify",
        "write"
      ],
      "title": "RequestMode",
      "type": "string"
    },
    "ResponseIntent": {
      "enum": [
        "auto",
        "reference",
        "focused",
        "deep"
      ],
      "title": "ResponseIntent",
      "type": "string"
    },
    "RiskLevel": {
      "enum": [
        "normal",
        "production",
        "security-critical",
        "safety-critical"
      ],
      "title": "RiskLevel",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "mode": {
      "$ref": "#/$defs/RequestMode"
    },
    "objective": {
      "minLength": 3,
      "title": "Objective",
      "type": "string"
    },
    "repo_root": {
      "default": ".",
      "title": "Repo Root",
      "type": "string"
    },
    "domains": {
      "items": {
        "type": "string"
      },
      "title": "Domains",
      "type": "array"
    },
    "focus": {
      "items": {
        "type": "string"
      },
      "title": "Focus",
      "type": "array"
    },
    "constraints": {
      "items": {
        "type": "string"
      },
      "title": "Constraints",
      "type": "array"
    },
    "questions": {
      "items": {
        "type": "string"
      },
      "title": "Questions",
      "type": "array"
    },
    "include": {
      "items": {
        "type": "string"
      },
      "title": "Include",
      "type": "array"
    },
    "exclude": {
      "items": {
        "type": "string"
      },
      "title": "Exclude",
      "type": "array"
    },
    "artifacts": {
      "items": {
        "$ref": "#/$defs/ArtifactSpec"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notes"
    },
    "include_git_diff": {
      "default": false,
      "title": "Include Git Diff",
      "type": "boolean"
    },
    "freshness": {
      "$ref": "#/$defs/Freshness",
      "default": "version-specific"
    },
    "risk": {
      "$ref": "#/$defs/RiskLevel",
      "default": "normal"
    },
    "max_context_bytes": {
      "default": 180000,
      "maximum": 50000000,
      "minimum": 4096,
      "title": "Max Context Bytes",
      "type": "integer"
    },
    "site": {
      "default": "chatgpt",
      "title": "Site",
      "type": "string"
    },
    "tunnel": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tunnel"
    },
    "tunnel_policy": {
      "default": "auto",
      "title": "Tunnel Policy",
      "type": "string"
    },
    "conversation_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Conversation Id"
    },
    "conversation_mode": {
      "default": "persistent",
      "enum": [
        "temporary",
        "persistent"
      ],
      "title": "Conversation Mode",
      "type": "string"
    },
    "session_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Session Id"
    },
    "chat_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Chat Id"
    },
    "chat_policy": {
      "$ref": "#/$defs/ChatPolicy",
      "default": "continue"
    },
    "response_intent": {
      "$ref": "#/$defs/ResponseIntent",
      "default": "auto"
    },
    "relevance_policy": {
      "$ref": "#/$defs/RelevanceSufficiencyPolicy"
    }
  },
  "required": [
    "mode",
    "objective"
  ],
  "title": "RawRequest",
  "type": "object"
}