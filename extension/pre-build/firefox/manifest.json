{
  "manifest_version": 3,
  "name": "FancyGPT Browser Tunnel",
  "version": "0.8.0",
  "description": "Connect an existing ChatGPT or Gemini browser session to FancyGPT without exporting cookies or tokens.",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://gemini.google.com/*",
    "https://grok.com/*",
    "https://x.com/i/grok*",
    "https://copilot.microsoft.com/*",
    "https://m365.cloud.microsoft/*"
  ],
  "background": {
    "scripts": [
      "bridge_transport.js",
      "background.js"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "FancyGPT Tunnel"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://gemini.google.com/*",
        "https://grok.com/*",
        "https://x.com/i/grok*",
        "https://copilot.microsoft.com/*",
        "https://m365.cloud.microsoft/*"
      ],
      "js": [
        "page_hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "site_kit.js",
        "site_chatgpt.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "site_kit.js",
        "site_gemini.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://grok.com/*",
        "https://x.com/i/grok*",
        "https://copilot.microsoft.com/*",
        "https://m365.cloud.microsoft/*"
      ],
      "js": [
        "observer.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "fancy-gpt@local"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "page_hook.js"
      ],
      "matches": [
        "https://chatgpt.com/*",
        "https://gemini.google.com/*",
        "https://grok.com/*",
        "https://copilot.microsoft.com/*",
        "https://m365.cloud.microsoft/*"
      ]
    }
  ]
}
